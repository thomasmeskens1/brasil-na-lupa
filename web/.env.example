# Cadastro de usuários (opcional). Copie para .env.local e preencha — NUNCA faça commit de valores.
# Sem as quatro primeiras variáveis, o cadastro fica desligado e o site funciona sem contas.
# Passo a passo: docs/cadastro/configurar.md

# Banco Neon Postgres (criado pela aba Storage da Vercel; a integração define esta variável).
DATABASE_URL=
# Segredo do Auth.js (gere com: npx auth secret  ou  openssl rand -base64 33).
AUTH_SECRET=
# Chave de API do Resend (envio do link de acesso por e-mail).
AUTH_RESEND_KEY=
# Remetente verificado no Resend, ex.: Placar do Poder <no-reply@placardopoder.com.br>
EMAIL_FROM=

# Opcionais: "Entrar com Google" só aparece se as duas existirem.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Só para testes locais com "next start"/"next dev" fora da Vercel (ex.: http://localhost:3000).
# AUTH_URL=
# AUTH_TRUST_HOST=true
