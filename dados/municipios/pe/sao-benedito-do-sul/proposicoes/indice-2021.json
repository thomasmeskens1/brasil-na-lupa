    {"id":"pe-5","id_oficial":5,"uf":"PE","casa":"cm-sao-benedito-do-sul","sigla":"REQ","tipo":"Requerimento","numero":6,"ano":2021,"identificacao":"REQ 6/2021","data_apresentacao":"2021-09-09","ementa":"Requeiro a Mesa Diretora da Câmara Municipal de São Benedito do Sul PE, cumpridas as formalidades legais e regimentais, após de ouvido o\nPlenário, sendo aprovado, enviar ao Poder Executivo Municipal, em caráter de urgência, para dar cumprimento ao presente requerimento no sentido de que /'\"' seja implantado urgentemente um sistema de abastecimento de água potável no Loteamento Pedra do Bode, próximo a cidade baixa, nesta cidade de São Benedito do Sul.","apelido":null,"em_tramitacao":false,"autores":[{"nome":"João Paulo","parlamentar_id":"4"}],"situacao":{"texto":null,"status":"Matéria Arquivada","data":"2023-12-18"},"url":"https://sapl.saobeneditodosul.pe.leg.br/materia/5","url_texto":"http://sapl.saobeneditodosul.pe.leg.br/media/sapl/public/materialegislativa/2021/5/req_06_2021.pdf","fonte_dados":"https://sapl.saobeneditodosul.pe.leg.br/api/materia/materialegislativa/5/","tipo_id":2,"autores_ids":[1],"ultima_tramitacao":{"id":23,"data":"2023-12-18","status_id":49,"texto":null},"atualizado_fonte":"2023-12-18T09:55:14.958322-03:00","lacunas":[],"lacunas_fonte":[]},
    {"id":"pe-4","id_oficial":4,"uf":"PE","casa":"cm-sao-benedito-do-sul","sigla":"REQ","tipo":"Requerimento","numero":2,"ano":2021,"identificacao":"REQ 2/2021","data_apresentacao":"2021-04-20","ementa":"OBJETIVO: Construção de ponto de ônibus, melhorar a iluminação e instalar placas de\nsinalização na entrada do distrito de Igarapeba.\nNa condição de Vereador, legítimo representante do povo são-beneditense, venho\nrequerer a Mesa Diretora da Câmara Municipal de São Benedito do Sul/PE, depois de\nouvido o Plenário e cumpridas as formalidades regimentais, seja solicitado ao\nExcelentíssimo Chefe do Poder Executivo Municipal, o Sr. [nome de particular omitido], que construa um ponto de ônibus, melhore a iluminação pública e instale\nplacas de sinalização na entrada do distrito de Igarapeba.\nDiante a importância do tema a ser abordado, que ensejou o envio do referido\nrequerimento, sendo certo que será recepcionado por esta Egrégia Casa legislativa e\ndevidamente aprovado pela unanimidade dos edis.","apelido":null,"em_tramitacao":false,"autores":[{"nome":"João Paulo","parlamentar_id":"4"}],"situacao":{"texto":null,"status":"Matéria Arquivada","data":"2023-12-18"},"url":"https://sapl.saobeneditodosul.pe.leg.br/materia/4","url_texto":"http://sapl.saobeneditodosul.pe.leg.br/media/sapl/public/materialegislativa/2021/4/req_02_2021.pdf","fonte_dados":"https://sapl.saobeneditodosul.pe.leg.br/api/materia/materialegislativa/4/","tipo_id":2,"autores_ids":[1],"ultima_tramitacao":{"id":19,"data":"2023-12-18","status_id":49,"texto":null},"atualizado_fonte":"2023-12-18T09:55:14.240478-03:00","lacunas":[],"lacunas_fonte":[]}
