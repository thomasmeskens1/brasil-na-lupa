    {"id":"pe-12","id_oficial":12,"uf":"PE","casa":"cm-sao-benedito-do-sul","sigla":"REQ","tipo":"Requerimento","numero":3,"ano":2022,"identificacao":"REQ 3/2022","data_apresentacao":"2022-04-07","ementa":"Requeiro a Mesa Diretora da Câmara Municipal de São Benedito do SuIJPE, cumpridas as\nformalidades legais e regimentais, após de ouvido o Plenário, sendo aprovado, enviar ao Sr.\n[nome de particular omitido], Presidente do Departamento de Estradas e Rodagens de Pernambuco\nDER/PE, o presente requerimento, no sentido de que seja realizada a manutenção e a\nalargamento do acostamento da PE 126 que liga o município de Catende até o município de\nQuipapá, tendo em vista que há dez anos encontra-se abandonada, com vegetação invadindo a\nvia principal causando acidentes fatais e impedindo veículos de utilizar o acostamento.\nRenovo aos dignos pares os protestos de elevado apreço e consideração.","apelido":null,"em_tramitacao":false,"autores":[{"nome":"Amilton Costa","parlamentar_id":"1"}],"situacao":{"texto":null,"status":"Matéria Arquivada","data":"2023-12-18"},"url":"https://sapl.saobeneditodosul.pe.leg.br/materia/12","url_texto":"http://sapl.saobeneditodosul.pe.leg.br/media/sapl/public/materialegislativa/2022/12/requerimento3.pdf","fonte_dados":"https://sapl.saobeneditodosul.pe.leg.br/api/materia/materialegislativa/12/","tipo_id":2,"autores_ids":[4],"ultima_tramitacao":{"id":26,"data":"2023-12-18","status_id":49,"texto":null},"atualizado_fonte":"2023-12-18T09:55:15.590158-03:00","lacunas":[],"lacunas_fonte":[]},
