    {"id":"pr-796","id_oficial":796,"uf":"PR","casa":"cm-antonio-olinto","sigla":"INDV","tipo":"Indicação Verbal","numero":129,"ano":2023,"identificacao":"INDV 129/2023","data_apresentacao":"2023-12-20","ementa":"Solicitou ao Poder Executivo, por meio da Secretaria de Obras, realizado um trabalho de reestruturação na estrada que dá acesso à propriedade do Sr. [nome de particular omitido], na comunidade de Avencal. Justificou afirmando ter ouvido o relato do Proprietário, que disse já ter conversado com o Presidente José Joarez sobre a situação, porém aguarda uma solução, salientando que justo neste período, época da safra de fumo, na qual mais exige estrada boa para escoamento da produção, o principal acesso à esta propriedade encontra-se intransitável.","apelido":null,"em_tramitacao":true,"autores":[{"nome":"Gilciano Moreira","parlamentar_id":"10"}],"situacao":null,"url":"https://sapl.antonioolinto.pr.leg.br/materia/796","url_texto":"http://sapl.antonioolinto.pr.leg.br/media/sapl/public/materialegislativa/2023/796/129.pdf","fonte_dados":"https://sapl.antonioolinto.pr.leg.br/api/materia/materialegislativa/796/","tipo_id":13,"autores_ids":[10],"ultima_tramitacao":null,"atualizado_fonte":"2023-12-21T11:43:57.824014-03:00","lacunas":[],"lacunas_fonte":[]},
    {"id":"pr-795","id_oficial":795,"uf":"PR","casa":"cm-antonio-olinto","sigla":"INDV","tipo":"Indicação Verbal","numero":128,"ano":2023,"identificacao":"INDV 128/2023","data_apresentacao":"2023-12-20","ementa":"Solicitou ao Poder Executivo, por meio da Secretaria de Obras, realizado um trabalho de reestruturação na estrada que dá acesso à propriedade do Sr. [nome de particular omitido] da comunidade de Água Amarela de Baixo. Justificou afirmando já ter comunicado o Setor de Obras anteriormente, onde foi acertado que seriam priorizados os trabalhos que exigiam urgência, para assim seguir com a programação normal, atendendo inclusive as Indicações, porém a situação se agravou à ponto do Sr. [nome de particular omitido] citado, precisou se mudar pra outra casa onde paga aluguem, devido a precariedade da estrada","apelido":null,"em_tramitacao":true,"autores":[{"nome":"Gilciano Moreira","parlamentar_id":"10"}],"situacao":null,"url":"https://sapl.antonioolinto.pr.leg.br/materia/795","url_texto":"http://sapl.antonioolinto.pr.leg.br/media/sapl/public/materialegislativa/2023/795/128.pdf","fonte_dados":"https://sapl.antonioolinto.pr.leg.br/api/materia/materialegislativa/795/","tipo_id":13,"autores_ids":[10],"ultima_tramitacao":null,"atualizado_fonte":"2023-12-21T11:41:11.917187-03:00","lacunas":[],"lacunas_fonte":[]},
