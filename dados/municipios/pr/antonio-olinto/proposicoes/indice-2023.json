    {"id":"pr-789","id_oficial":789,"uf":"PR","casa":"cm-antonio-olinto","sigla":"INDV","tipo":"Indicação Verbal","numero":126,"ano":2023,"identificacao":"INDV 126/2023","data_apresentacao":"2023-12-06","ementa":"“Solicitando ao Poder Executivo, para que através do Setor de Obras seja realizado um trabalho amplo de reestruturação nas estradas Secundárias nas comunidades de Água Amarela de Baixo, Água Amarela do Meio, e Água Amarela de Cima.\nJustificou a importância da presente Indicação, afirmando que trafegou todos os trajetos nas referidas comunidades, onde presenciou vários trechos danificados pela grande quantidade de chuvas dos últimos dias, necessitando todo tipo de melhorias para garantir o direito de ir e vir à População”.","apelido":null,"em_tramitacao":true,"autores":[{"nome":"Marinaldo Schmidt Lemes","parlamentar_id":"6"}],"situacao":null,"url":"https://sapl.antonioolinto.pr.leg.br/materia/789","url_texto":"http://sapl.antonioolinto.pr.leg.br/media/sapl/public/materialegislativa/2023/789/126.pdf","fonte_dados":"https://sapl.antonioolinto.pr.leg.br/api/materia/materialegislativa/789/","tipo_id":13,"autores_ids":[6],"ultima_tramitacao":null,"atualizado_fonte":"2023-12-11T16:27:12.089439-03:00","lacunas":[],"lacunas_fonte":[]},
