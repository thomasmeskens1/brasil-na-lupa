    {"id":"ato-da-mesa-0002-2020","id_oficial":14,"uf":"PR","casa":"cm-ouro-verde-do-oeste","tipo":"Ato da Mesa","sigla_tipo":"ATM","numero":"0002","ano":2020,"nome_oficial":"Ato da Mesa nº 2, de 23 de março de 2020","data":"2020-03-23","data_publicacao":"2020-03-23","publicacao":"Jornal do Oeste","ementa":"A MESA DIRETIVA DA CÃMARA MUNICIPAL DE OURO VERDE DO OESTE, Estado do Paraná, no uso das atribuições que lhe são conferidas legais e regimentais:\n\nCONSIDERANDO que a doença chamada de CORONAVÍRUS (COVID-19) é uma família de vírus que causam infecções respiratórias, sendo grave e em alguns casos, letal;\nCONSIDERANDO que o Ministério da Saúde adotou medidas orientando Cancelar ou Adiar eventos pontuais em locais fechados;\nCONSIDERANDO as decisões marcantes em todo o Brasil, sejam nas empresas privadas, esporte e serviços público;\n\nRESOLVE:","esfera":"M","projeto_origem":null,"url":"https://sapl.ouroverdedooeste.pr.leg.br/norma/14","url_texto":"http://sapl.ouroverdedooeste.pr.leg.br/media/sapl/public/normajuridica/2020/14/14_texto_integral.pdf","fonte":{"titulo":"Ato da Mesa nº 2, de 23 de março de 2020","url":"https://sapl.ouroverdedooeste.pr.leg.br/api/norma/normajuridica/14/","orgao":"Câmara Municipal de Ouro Verde do Oeste","acessado_em":"2026-11-11"},"tipo_id":14,"materia_id":null,"veiculo_publicacao":"Jornal do Oeste","atualizado_fonte":"2026-04-30T00:45:26.832020-03:00","lacunas":[],"lacunas_fonte":[]},
