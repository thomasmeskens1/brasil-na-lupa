    {"id":"mt-24877","id_oficial":24877,"uf":"MT","casa":"cm-campo-novo-do-parecis","sigla":"REQ","tipo":"Requerimento","numero":110,"ano":2023,"identificacao":"REQ 110/2023","data_apresentacao":"2023-08-17","ementa":"Requer, ouvido o soberano Plenário, com fundamento no art. 23, XIII, da Lei Orgânica Municipal, ao Sr. [nome de particular omitido], por intermédio da Secretaria Municipal de Saúde, o porquê de Campo Novo do Parecis não constar no anexo da PORTARIA GM/GM Nº 1.135, de 16.08.2023, do Ministério da Saúde, que estabelece os critérios e procedimentos para o repasse da assistência financeira complementar da União destinada ao cumprimento do piso salarial nacional de enfermeiros, técnicos e auxiliares de enfermagem e parteiras e dispõe sobre o repasse referente ao exercício de 2023. Referido anexo contém uma  listagem de municípios de todo o país e os respectivos valores a serem transferidos para os meses de maio, junho, julho e agosto.","apelido":null,"em_tramitacao":false,"autores":[{"nome":"MARCIO CLEI FERREIRA DO NASCIMENTO","parlamentar_id":"401"}],"situacao":null,"url":"https://sapl.camponovodoparecis.mt.leg.br/materia/24877","url_texto":"http://sapl.camponovodoparecis.mt.leg.br/media/sapl/public/materialegislativa/2023/24877/modelo-requerimento.docx","fonte_dados":"https://sapl.camponovodoparecis.mt.leg.br/api/materia/materialegislativa/24877/","tipo_id":134,"autores_ids":[401],"ultima_tramitacao":null,"atualizado_fonte":"2023-08-16T20:00:00-04:00","lacunas":[],"lacunas_fonte":[]},
