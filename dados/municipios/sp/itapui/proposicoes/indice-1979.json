    {"id":"sp-9978","id_oficial":9978,"uf":"SP","casa":"cm-itapui","sigla":"IND","tipo":"Indicação","numero":22,"ano":1979,"identificacao":"IND 22/1979","data_apresentacao":"1979-10-18","ementa":"Indico ao Sr. prefeito no sentido de estender o Perímetro Urbano a área que corresponde a margem  esquerda do rio Tietê, até a estrada que demanda ao Bairro Barrizinho, em toda a sua extensão, partindo do Sítio Magon até a propriedade do Sr. [nome de particular omitido], ou mais precisamente até a pedreira. Tal medida se prende ao fato de que referida área se acha quase totalmente tomada por belíssimas construções e que sem dúvida irá trazer benefícios de arrecadação ao município.","apelido":null,"em_tramitacao":false,"autores":[],"situacao":null,"url":"https://sapl.itapui.sp.leg.br/materia/9978","url_texto":"http://sapl.itapui.sp.leg.br/media/sapl/public/materialegislativa/1979/9978/indicacao_no_22_de_1979.pdf","fonte_dados":"https://sapl.itapui.sp.leg.br/api/materia/materialegislativa/9978/","tipo_id":13,"autores_ids":[66],"ultima_tramitacao":null,"atualizado_fonte":"2026-11-16T14:50:48.170684-03:00","lacunas":["Autoria: tabela de autores ainda não coletada por completo."],"lacunas_fonte":[]},
