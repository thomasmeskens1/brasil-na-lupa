    {"id":"sp-23407","id_oficial":23407,"uf":"SP","casa":"cm-dracena","sigla":"IND","tipo":"Indicação","numero":288,"ano":2013,"identificacao":"IND 288/2013","data_apresentacao":"2013-04-29","ementa":"Indico ao Sr. [nome de particular omitido], de acordo com o Regimento Interno dessa egrégia Casa de Leis, que em contato com o setor competente estude a pos-sibilidade de instalar postes com iluminação pública na região onde foi insta-lada a academia ao ar livre no Bairro Emílio Zanatta.\nOs moradores do  bairro reclamam da falta de iluminação, pois no local há a presença de pessoas que aparentemente fazem o uso de drogas e que deixaram pichações fazendo apologia a uma facção criminosa, que age dentro e fora dos presídios. Estamos reiterando tal indicação para que se providencie o pedido que fora feito desde outubro do ano passado (indica-ção número 220/2012- de 22/10/2012).","apelido":null,"em_tramitacao":false,"autores":[{"nome":"Juliano Brito Bertolini","parlamentar_id":"139"}],"situacao":null,"url":"https://sapl.dracena.sp.leg.br/materia/23407","url_texto":"http://sapl.dracena.sp.leg.br/media/sapl/public/materialegislativa/2013/23407/i0028813.pdf","fonte_dados":"https://sapl.dracena.sp.leg.br/api/materia/materialegislativa/23407/","tipo_id":18,"autores_ids":[209],"ultima_tramitacao":null,"atualizado_fonte":"2026-02-26T08:34:56.882118-03:00","lacunas":[],"lacunas_fonte":[]},
