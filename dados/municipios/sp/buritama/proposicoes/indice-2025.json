    {"id":"sp-4064","id_oficial":4064,"uf":"SP","casa":"cm-buritama","sigla":"REQ","tipo":"Requerimento","numero":234,"ano":2025,"identificacao":"REQ 234/2025","data_apresentacao":"2025-11-27","ementa":"Nós, ABAIXO ASSINADOS, vereadores, com assento na Câmara Municipal de Buritama, Estado de São Paulo, depois de ouvido o douto Plenário, REQUEREMOS, seja  expedida uma MOÇÃO DE APLAUSO em favor dos integrantes da Polícia Militar Cb PM Fernando Oiel Tardochi, Cb PM Ronald Lourençato, Cb PM Everton Barbosa e Sd PM Rodrigo de Oliveira Borges, pelos relevantes serviços reconhecidamente prestados ao nosso município. Os homenageados destacaram-se pelo profissionalismo, dedicação e comprometimento no cumprimento do dever, contribuindo significativamente para a preservação da ordem pública e a promoção da segurança dos cidadãos de Buritama. Seus atos de coragem, conduta ilibada e respeito à comunidade refletem o mais elevado espírito de servir e proteger, honrando a instituição Polícia Militar do Estado de São Paulo.","apelido":null,"em_tramitacao":false,"autores":[{"nome":"ADRIANO TUSTÃO","parlamentar_id":"26"},{"nome":"ANDRÉ DO ZÉ CARLÃO","parlamentar_id":"27"},{"nome":"ANÍZIO","parlamentar_id":"28"},{"nome":"ANTONIO CARLOS","parlamentar_id":"2"},{"nome":"CARLINHO DO DIVINO","parlamentar_id":"5"},{"nome":"CRISTINA NOBRE","parlamentar_id":"32"},{"nome":"DR. WALLISON","parlamentar_id":"80"},{"nome":"FEBEM","parlamentar_id":"3"},{"nome":"FERNANDA MACENO","parlamentar_id":"79"},{"nome":"MIKAEL DISK FRETE","parlamentar_id":"78"},{"nome":"TONHÃO DA EDITORA","parlamentar_id":"29"}],"situacao":null,"url":"https://sapl.buritama.sp.leg.br/materia/4064","url_texto":"http://sapl.buritama.sp.leg.br/media/sapl/public/materialegislativa/2025/4064/requerimento_no_234.pdf","fonte_dados":"https://sapl.buritama.sp.leg.br/api/materia/materialegislativa/4064/","tipo_id":3,"autores_ids":[43,44,45,1,10,49,61,11,62,63,46],"ultima_tramitacao":null,"atualizado_fonte":"2026-06-26T09:27:47.937301-03:0