    {"id":"sc-2546","id_oficial":2546,"uf":"SC","casa":"cm-canoinhas","sigla":"REQ","tipo":"Requerimento","numero":287,"ano":2014,"identificacao":"REQ 287/2014","data_apresentacao":"2014-09-15","ementa":"REQUERIMENTO Nº 287/2014, DE [trecho em dúvida 172ecbe8c9293131], O VEREADOR  INFRA-ASSINADO, NO USO DAS PRERROGATIVAS QUE LHES SÃO CONFERIDAS PELO REGIMENTO INTERNO DA CASA, SOLICITA QUE SEJA ENCAMINHADO REQUERIMENTO PARABENIZANDO A CAPELA NOSSA SENHORA DAS GRAÇAS DA VILA FUCK,  PELO RESGATE CULTURAL DA NOSSA REGIÃO COM A REALIZAÇÃO DO FANDANGO À SÃO GONÇALO NO ÚLTIMO DIA 13 DE SETEMBRO.","apelido":null,"em_tramitacao":false,"autores":[{"nome":"João Grein","parlamentar_id":"21"}],"situacao":null,"url":"https://sapl.canoinhas.sc.leg.br/materia/2546","url_texto":"http://sapl.canoinhas.sc.leg.br/media/sapl/public/materialegislativa/2014/2546/2546_texto_integral.pdf","fonte_dados":"https://sapl.canoinhas.sc.leg.br/api/materia/materialegislativa/2546/","tipo_id":14,"autores_ids":[23],"ultima_tramitacao":null,"atualizado_fonte":"2019-09-06T19:40:07.673901-03:00","privacidade_pendente":true,"lacunas":["Trecho com possível nome de particular aguardando conferência; mostrado como \"[trecho em dúvida …]\" até a curadoria (diretriz 12)."],"lacunas_fonte":[]},
    {"id":"sc-2545","id_oficial":2545,"uf":"SC","casa":"cm-canoinhas","sigla":"REQ","tipo":"Requerimento","numero":286,"ano":2014,"identificacao":"REQ 286/2014","data_apresentacao":"2014-09-15","ementa":"REQUERIMENTO Nº 286/2014, DE AUTORIA DO EDIL WILMAR SUDOSKI, OS VEREADORES INFRA-ASSINADO, NO USO DAS ATRIBUIÇÕES QUE LHE SÃO CONFERIDAS PELO REGIMENTO INTERNO DA CÂMARA, PARABENIZAM O 9º BATALHÃO DE BOMBEIROS MILITAR PELOS 30 ANOS DE INSTALAÇÃO NO MUNICÍPIO, DATA CELEBRADA EM 12 DE SETEMBRO DO CORRENTE ANO.\n\nAGRADECEM O TENENTE CORONEL ALTAIR LACOWICZ, COMANDANTE DA CORPORAÇÃO E OS DEMAIS BOMBEIROS MILITARES DA ATIVA E DA RESERVA PELOS RELEVANTES SERVIÇOS PRESTADOS À POPULAÇÃO DE CANOINHAS E REGIÃO AO LONGO DESSAS TRÊS DÉCADAS DE ATUAÇÃO.\n\nEXPRESSA O RECONHECIMENTO A ESSA IMPORTANTE INSTITUIÇÃO QUE TRABALHA EM DEFESA DA SOCIEDADE. DESTACA TAMBÉM OS SEUS VALOROSOS MEMBROS QUE, AO SALVAREM VIDAS, FAMÍLIAS E PATRIMÔNIOS, ACABAM COLOCANDO EM RISCO SUAS PRÓPRIAS VIDAS EM TROCA DO CUMPRIMENTO DO DEVER E DA AJUDA AO PRÓXIMO.","apelido":null,"em_tramitacao":false,"autores":[{"nome":"Pike","parlamentar_id":"235"},{"nome":"Wilmar Sudoski","parlamentar_id":"239"}],"situacao":null,"url":"https://sapl.canoinhas.sc.leg.br/materia/2545","url_texto":"http://sapl.canoinhas.sc.leg.br/media/sapl/public/materialegislativa/2014/2545/2545_texto_integral.pdf","fonte_dados":"https://sapl.canoinhas.sc.leg.br/api/materia/materialegislativa/2545/","tipo_id":14,"autores_ids":[34,38],"ultima_tramitacao":null,"atualizado_fonte":"2019-09-06T19:40:06.398162-03:00","lacunas":[],"lacunas_fonte":[]},
    {"id":"sc-2544","id_oficial":2544,"uf":"SC","casa":"cm-canoinhas","sigla":"REQ","tipo":"Requerimento","numero":285,"ano":2014,"identificacao":"REQ 285/2014","data_apresentacao":"2014-09-15","ementa":"REQUERIMENTO Nº 285/2014, DE AUTORIA DO EDIL WILMAR SUDOSKI, OS VEREADORES INFRA-ASSINADO, NO USO DAS PRERROGATIVAS QUE LHE SÃO CONFERIDAS PELO REGIMENTO INTERNO DA CÂMARA, PARABENIZAM O ENGENHEIRO CIVIL, SENHOR [nome de particular omitido], POR SUA ELEIÇÃO COMO NOVO PRESIDENTE DA ASSOCIAÇÃO EMPRESARIA DE CANOINHAS (ACIC).\n\nTENDO COMO BASE A CREDIBILIDADE QUE POSSUI PERANTE A SOCIEDADE E DE SUA CAPACIDADE PROFISSIONAL, FICA A CERTEZA DE QUE A GESTÃO QUE ORA INICIA DESENVOLVERÁ PARCERIAS E TRARÁ BENEFÍCIOS AOS EMPRESÁRIOS E SEUS COLABORADORES, CONTRIBUINDO DIRETAMENTE PARA O DESENVOLVIMENTO SÓCIO-ECONÔMICO DE CANOINHAS E REGIÃO.\n\nFICA AINDA A CONVICÇÃO DE QUE OS NOVOS INTEGRANTES DA DIRETORIA EXECUTIVA E DOS CONSELHOS FISCAL E DELIBERATIVO, ATUARÃO DE MANEIRA DECISIVA E DE APOIO A PRESIDÊNCIA NAS TOMADAS DE DECISÕES, PRINCIPALMENTE, AQUELAS QUE ESTIMULAM O EMPREENDEDORISMO E O PROFISSIONALISMO POR PARTE DOS ASSOCIADOS.","apelido":null,"em_tramitacao":false,"autores":[{"nome":"Pike","parlamentar_id":"235"},{"nome":"Wilmar Sudoski","parlamentar_id":"239"}],"situacao":null,"url":"https://sapl.canoinhas.sc.leg.br/materia/2544","url_texto":"http://sapl.canoinhas.sc.leg.br/media/sapl/public/materialegislativa/2014/2544/2544_texto_integral.pdf","fonte_dados":"https://sapl.canoinhas.sc.leg.br/api/materia/materialegislativa/2544/","tipo_id":14,"autores_ids":[34,38],"ultima_tramitacao":null,"atualizado_fonte":"2019-09-06T19:40:10.829406-03:00","lacunas":[],"lacunas_fonte":[]},
    {"id":"sc-2543","id_oficial":2543,"uf":"SC","casa":"cm-canoinhas","sigla":"REQ","tipo":"Requerimento","numero":284,"ano":2014,"identificacao":"REQ 284/2014","data_apresentacao":"2014-09-15","ementa":"REQUERIMENTO Nº 284/2014, DE AUTORIA DO EDIL WILMAR SUDOSKI, OS VEREADORES INFRA-ASSINADO, NO USO DAS PRERROGATIVAS QUE LHE SÃO CONFERIDAS PELO REGIMENTO INTERNO DA CÂMARA, [trecho em dúvida a1a01c0da2576587], COMPROMETIDA E TRANSPARENTE QUAL CONDUZIU A DIRETORIA EXECUTIVA DA ASSOCIAÇÃO EMPRESARIAL DE CANOINHAS (ACIC) EM DOIS MANDATOS: 2010 A 2012 E 2012 A 2014.\nVALE RESSALTAR, QUE NESSE PERÍODO, A ENTIDADE SE CONFIGUROU COMO UMA DAS PRINCIPAIS ASSOCIAÇÕES EMPRESARIAIS DO ESTADO DE SANTA CATARINA. TEVE PAPEL RELEVANTE NO FORTALECIMENTO DA INDÚSTRIA E DO COMÉRCIO EM CANOINHAS E REGIÃO. DESENVOLVEU AÇÕES E APLICOU ESTRATÉGIAS QUE INCENTIVARAM A CRIAÇÃO DE NOVOS POSTOS DE TRABALHO E A GERAÇÃO DE RENDA, FAZENDO COM QUE A ECONOMIA LOCAL FOSSE INCREMENTADA E INTERFERISSE DIRETAMENTE NA MELHORA DA QUALIDADE DE VIDA E NO BEM ESTAR DA COMUNIDADE.\nAO TAMBÉM PARABENIZAR OS DEMAIS MEMBROS DA DIRETORIA EXECUTIVA E DOS CONSELHOS FISCAL E DELIBERATIVO, É IMPORTANTE DESTACAR ALGUMAS DAS CONQUISTAS OBTIDAS PELA GESTÃO QUE ORA SE FINDA.\nENTRE AS QUAIS, A ABERTURA DO CENTRO DE ATENDIMENTO SEBRAE AO EMPREENDEDOR CASE; A IMPLANTAÇÃO DO ÚTIL CARD NA PREFEITURA MUNICIPAL DE CANOINHAS; O PROGRAMA DE GESTÃO E VIVÊNCIA EMPRESARIAL (PGVE), A APROVAÇÃO DO PROJETO DO NÚCLEO DE REPARAÇÃO AUTOMOTIVA DE CANOINHAS E TRÊS BARRAS (NACT) PELO EMPREENDER E O ACOMPANHAMENTO FEITO EM MAIS DE 800 EMPRESAS DA REGIÃO.","apelido":null,"em_tramitacao":false,"autores":[{"nome":"Pike","parlamentar_id":"235"},{"nome":"Wilmar Sudoski","parlamentar_id":"239"}],"situacao":null,"url":"https://sapl.canoinhas.sc.leg.br/materia/2543","url_texto":"http://sapl.canoinhas.sc.leg.br/media/sapl/public/materialegislativa/2014/2543/2543_texto_integral.pdf","fonte_dados":"https://sapl.canoinhas.sc.leg.br/api/materia/materialegislativa/2543/","tipo_id":14,"autores_ids":[34,38],"ultima_tramitacao":null,"atualizado_fonte":"2019-09-06T19:40:01.700208-03:00","privacidade_pendente":true,"lacunas":["Trecho com possível nome de particular aguardando conferência; mostrado como \"[trecho em dúvida …]\" até a curadoria (diretriz 12)."],"lacunas_fonte":[]},
